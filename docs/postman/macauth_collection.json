{
  "info": {
    "_postman_id": "4a71de04-cd5e-49b2-be2b-c8ffea6b251a",
    "name": "Macauth API",
    "description": "API requests collection for macauth (service-to-service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
