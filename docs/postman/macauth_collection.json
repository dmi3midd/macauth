{
  "info": {
    "_postman_id": "4a71de04-cd5e-49b2-be2b-c8ffea6b251a",
    "name": "macauth API Collection",
    "description": "API requests collection for macauth (service-to-service). All tokens and clientId are passed via request/response body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Client API",
      "item": [
        {
          "name": "Link Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Extract and save clientId from body\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"clientId\");",
                  "    pm.environment.set(\"clientId\", jsonData.clientId);",
                  "    console.log(\"Saved clientId to environment: \" + jsonData.clientId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{clientName}}\",\n  \"secret\": \"{{clientSecret}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/client",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "client"
              ]
            },
            "description": "Register/Link a new client service to get a clientId. Returns clientId in response body. Requires API_KEY header."
          },
          "response": []
        },
        {
          "name": "Get Public Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Verify response contains key details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/client/public-key",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "client",
                "public-key"
              ]
            },
            "description": "Fetch the RSA public key used for local JWT signature validation."
          },
          "response": []
        },
        {
          "name": "Unlink Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/client/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "client",
                "{{clientId}}"
              ]
            },
            "description": "Remove the client and invalidate its credentials."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User API",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"permissions\": [\"pubex:read\", \"pubex:write\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/registration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "registration"
              ]
            },
            "description": "Register a new user. clientId is passed in request body."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Extract and save tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData).to.have.property(\"refreshToken\");",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    console.log(\"Saved accessToken and refreshToken to environment\");",
                  "});",
                  "",
                  "pm.test(\"Response contains user details and save userId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"user\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"userEmail\"));",
                  "    pm.expect(jsonData.user).to.have.property(\"userId\");",
                  "    pm.environment.set(\"userId\", jsonData.user.userId);",
                  "    console.log(\"Saved userId to environment: \" + jsonData.user.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "login"
              ]
            },
            "description": "Log in a user. Returns accessToken and refreshToken in response body."
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Validate email matches\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.Email).to.eql(pm.environment.get(\"userEmail\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "validate"
              ]
            },
            "description": "Validate the current JWT access token."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Update tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData).to.have.property(\"refreshToken\");",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    console.log(\"Refreshed and saved new accessToken and refreshToken\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "refresh"
              ]
            },
            "description": "Exchange refreshToken for new accessToken and refreshToken. Both tokens are passed via request/response body."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Clear local tokens\", function () {",
                  "    pm.environment.set(\"accessToken\", \"\");",
                  "    pm.environment.set(\"refreshToken\", \"\");",
                  "    console.log(\"Cleared accessToken and refreshToken from environment\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "logout"
              ]
            },
            "description": "Log out user by invalidating the refreshToken. Token is passed in request body."
          },
          "response": []
        },
        {
          "name": "Initiate Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Save resetToken to environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"resetToken\");",
                  "    pm.environment.set(\"resetToken\", jsonData.resetToken);",
                  "    console.log(\"Saved resetToken to environment: \" + jsonData.resetToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "reset"
              ]
            },
            "description": "Initiate password reset. Returns resetToken and email."
          },
          "response": []
        },
        {
          "name": "Confirm Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-client-id",
                "value": "{{clientId}}",
                "type": "text"
              },
              {
                "key": "x-client-secret",
                "value": "{{clientSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/api/v1/user/confirm-reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "api",
                "v1",
                "user",
                "confirm-reset"
              ]
            },
            "description": "Confirm password reset and set new password."
          },
          "response": []
        }
      ]
    }
  ]
}
