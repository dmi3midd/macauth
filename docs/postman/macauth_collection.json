  "item": [
    {
      "name": "Auth API",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains user details and save userId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"user\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"userEmail\"));",
                  "    pm.expect(jsonData.user).to.have.property(\"userId\");",
                  "    pm.environment.set(\"userId\", jsonData.user.userId);",
                  "    console.log(\"Saved userId to environment: \" + jsonData.user.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/auth/registration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "auth",
                "registration"
              ]
            },
            "description": "Register a new user."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Extract and save tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData).to.have.property(\"refreshToken\");",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    console.log(\"Saved accessToken and refreshToken to environment\");",
                  "});",
                  "",
                  "pm.test(\"Response contains user details and save userId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"user\");",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"userEmail\"));",
                  "    pm.expect(jsonData.user).to.have.property(\"userId\");",
                  "    pm.environment.set(\"userId\", jsonData.user.userId);",
                  "    console.log(\"Saved userId to environment: \" + jsonData.user.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "auth",
                "login"
              ]
            },
            "description": "Log in a user. Returns accessToken and refreshToken in response body."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Update tokens\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData).to.have.property(\"refreshToken\");",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    console.log(\"Refreshed and saved new accessToken and refreshToken\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "auth",
                "refresh"
              ]
            },
            "description": "Exchange refreshToken for new accessToken and refreshToken. Both tokens are passed via request/response body."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Clear local tokens\", function () {",
                  "    pm.environment.set(\"accessToken\", \"\");",
                  "    pm.environment.set(\"refreshToken\", \"\");",
                  "    console.log(\"Cleared accessToken and refreshToken from environment\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "auth",
                "logout"
              ]
            },
            "description": "Log out user by invalidating the refreshToken. Token is passed in request body."
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Validate email matches\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"userEmail\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"{{accessToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/macauth/auth/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "macauth",
                "auth",
                "validate"
              ]
            },
            "description": "Validate the current access token."
          },
          "response": []
        }
      ]
    },
    {
